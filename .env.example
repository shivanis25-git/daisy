# Port for Daisy Mail Server
PORT=3000

# Secret key for JWT authentication
JWT_SECRET="daisy-smart-mail-dev-secret"

# Optional: MongoDB connection string (e.g. mongodb://localhost:27017/daisy or MongoDB Atlas)
# Leave empty to automatically use the persistent local JSON store in data/daisy-store.json
MONGODB_URI=""

# Optional: Real SMTP settings for Gmail / Mailtrap / Custom SMTP
# If left empty, local Nodemailer transport is used with real Message-ID generation
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Daisy Mail <no-reply@daisy.mail>"
